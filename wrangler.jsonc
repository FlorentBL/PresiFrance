{
  // Site 100 % statique servi par Workers Static Assets (aucun script : pas de quota d'invocations).
  "name": "presifrance",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // Les pages SEO pré-générées sont dans <route>/index.html et leurs canonical n'ont pas de slash final.
    "html_handling": "drop-trailing-slash"
  },
  // www.presifrance.fr -> presifrance.fr : règle de redirection de la zone Cloudflare.
  "routes": [
    { "pattern": "presifrance.fr", "custom_domain": true }
  ]
}
