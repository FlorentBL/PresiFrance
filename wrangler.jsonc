{
  // Fichiers statiques (Workers Static Assets) + Worker (worker/index.js) pour les vrais 404 et les fiches commune
  // non prérendues. Voir « Worker » dans README.md.
  "name": "presifrance",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Pas de repli SPA automatique (il renvoyait l'accueil en 200 pour toute adresse) : le Worker décide.
    "not_found_handling": "none",
    // Les pages SEO pré-générées sont dans <route>/index.html et leurs canonical n'ont pas de slash final.
    "html_handling": "drop-trailing-slash"
  },
  // www.presifrance.fr -> presifrance.fr : règle de redirection de la zone Cloudflare.
  "routes": [
    { "pattern": "presifrance.fr", "custom_domain": true }
  ]
}
